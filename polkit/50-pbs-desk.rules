// pbs-desk: Backup aus dem Tray ohne Passwort starten/stoppen.
// Gilt nur fuer pbs-backup.service und nur fuer die aktive lokale Sitzung.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "pbs-backup.service" &&
        ["start", "stop", "restart"].indexOf(action.lookup("verb")) >= 0 &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});

// Einstellungen (pkexec pbs-settings) ohne Admin-Passwort, aber nur fuer den
// Desktop-Benutzer, den install.sh eingetragen hat, und nur in der aktiven
// lokalen Sitzung. Andere Konten brauchen weiter ein Admin-Passwort.
polkit.addRule(function(action, subject) {
    if (action.id == "de.exnolim.pbsdesk.settings" &&
        subject.user == "@DESKTOP_USER@" &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
