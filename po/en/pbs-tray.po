msgstr "Settings …"

msgid "Fehler (rc={rc})"
msgstr "Error (rc={rc})"

msgid "Fingerabdruck:"
msgstr "Fingerprint:"

msgid "Gesichert nach: {ziel}"
msgstr "Backed up to: {ziel}"

msgid "Gespeichert."
msgstr "Saved."

msgid "Handschalter: gebremst"
msgstr "manual: throttled"

