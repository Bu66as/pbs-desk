msgstr "Last backup one day ago"

msgid "Letztes Backup vor {tage} Tagen"
msgstr "Last backup {tage} days ago"

msgid "Liegt danach nur in einer Datei, die allein root lesen darf."
msgstr "Stored afterwards only in a file readable by root alone."

msgid "Mo–Fr während der Arbeitszeit nicht sichern"
msgstr "No backups during working hours Mon–Fri"

msgid "Nacht ab:"
msgstr "Night from:"

msgid "Nacht:"
msgstr "Night:"

msgid "Name der Sicherung auf dem Server. Leer = Rechnername."
msgstr "Name of the backup on the server. Empty = host name."

msgid "Name oder IPv4-Adresse des Proxmox Backup Servers. Leer = kein eigener Server."
msgstr "Name or IPv4 address of the Proxmox Backup Server. Empty = no custom server."

